# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/dailynews

# Port for backend Express server to listen on
PORT=5000

ADMIN_PASSCODE=""
# Cloudflare R2 Image Storage Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=indorelatest-images
R2_PUBLIC_DOMAIN=https://images.indorelatest.com
